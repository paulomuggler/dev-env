#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# theme-switch - Switch color themes across all dev-env tools
# -----------------------------------------------------------------------------
# Usage:
#   theme-switch [THEME] [VARIANT]
#   theme-switch list              # List available themes
#   theme-switch current           # Show current theme
#   theme-switch catppuccin latte  # Switch to Catppuccin Latte (light)
#   theme-switch catppuccin mocha  # Switch to Catppuccin Mocha (dark)
#
# Affected Tools:
#   - Tmux (status bar, borders)
#   - Neovim (LazyVim colorscheme)
#   - Bat (syntax highlighting)
#   - Yazi (file manager)
#   - Lazygit (git TUI)
#   - Bottom (system monitor)
#   - FZF (fuzzy finder)
#   - iTerm2 (terminal profile - optional)
# -----------------------------------------------------------------------------

set -euo pipefail

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Paths
DEVENV_ROOT="${HOME}/Projects/dev-env"
DOTFILES_DIR="${DEVENV_ROOT}/dotfiles"
THEME_STATE_FILE="${HOME}/.config/devenv/current-theme"

# Helper functions
info() {
  echo -e "${BLUE}[INFO]${NC} $*"
}

success() {
  echo -e "${GREEN}[OK]${NC} $*"
}

error() {
  echo -e "${RED}[ERROR]${NC} $*" >&2
}

warn() {
  echo -e "${YELLOW}[WARN]${NC} $*"
}

# Theme definitions
# Format: THEME:VARIANT:DESCRIPTION:LIGHT_OR_DARK
THEMES=(
  "catppuccin:latte:Catppuccin Latte (soothing pastel light):light"
  "catppuccin:frappe:Catppuccin Frappé (soft dark):dark"
  "catppuccin:macchiato:Catppuccin Macchiato (medium dark):dark"
  "catppuccin:mocha:Catppuccin Mocha (deep dark):dark"
  "tokyonight:day:Tokyo Night Day (bright light):light"
  "tokyonight:storm:Tokyo Night Storm (medium dark):dark"
  "tokyonight:night:Tokyo Night (deep dark):dark"
  "gruvbox:light:Gruvbox Light (retro warm light):light"
  "gruvbox:dark:Gruvbox Dark (retro warm dark):dark"
)

# Get current theme from state file
get_current_theme() {
  if [[ -f "$THEME_STATE_FILE" ]]; then
    cat "$THEME_STATE_FILE"
  else
    echo "catppuccin:mocha"  # Default
  fi
}

# Save theme to state file
save_current_theme() {
  local theme="$1"
  local variant="$2"
  mkdir -p "$(dirname "$THEME_STATE_FILE")"
  echo "${theme}:${variant}" > "$THEME_STATE_FILE"
}

# List available themes
list_themes() {
  echo ""
  echo -e "${CYAN}Available Themes:${NC}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  local current_theme
  current_theme=$(get_current_theme)

  for theme_spec in "${THEMES[@]}"; do
    IFS=':' read -r theme variant desc light_dark <<< "$theme_spec"
    local marker=" "
    if [[ "${theme}:${variant}" == "$current_theme" ]]; then
      marker="${GREEN}▶${NC}"
    fi

    printf "%b %-15s %-15s %s\n" "$marker" "$theme" "$variant" "$desc"
  done

  echo ""
}

# Show current theme
show_current() {
  local current_theme
  current_theme=$(get_current_theme)
  IFS=':' read -r theme variant <<< "$current_theme"

  echo ""
  echo -e "${CYAN}Current Theme:${NC} ${theme} ${variant}"
  echo ""
}

# Update tmux configuration
update_tmux() {
  local theme="$1"
  local variant="$2"
  local tmux_conf="${DOTFILES_DIR}/tmux/.config/tmux/tmux.conf"

  info "Updating tmux theme to ${theme} ${variant}..."

  case "$theme" in
    catppuccin)
      # Update Catppuccin flavour
      if grep -q "@catppuccin_flavour" "$tmux_conf"; then
        sed -i.bak "s/@catppuccin_flavour '.*'/@catppuccin_flavour '${variant}'/" "$tmux_conf"
        rm -f "${tmux_conf}.bak"
      else
        error "Catppuccin theme config not found in tmux.conf"
        return 1
      fi
      ;;
    *)
      warn "Tmux theme switching for ${theme} not yet implemented"
      return 0
      ;;
  esac

  # Reload tmux if running
  if tmux info &>/dev/null; then
    tmux source-file "$tmux_conf" 2>/dev/null || true
    success "Tmux config reloaded"
  else
    success "Tmux config updated (reload on next start)"
  fi
}

# Update neovim configuration
update_nvim() {
  local theme="$1"
  local variant="$2"
  local nvim_theme_file="${DOTFILES_DIR}/nvim/.config/nvim/lua/plugins/colorscheme.lua"

  info "Updating nvim theme to ${theme} ${variant}..."

  # We'll create a colorscheme.lua plugin file
  local colorscheme_name=""
  local background="dark"

  case "$theme" in
    catppuccin)
      colorscheme_name="catppuccin-${variant}"
      [[ "$variant" == "latte" ]] && background="light"
      ;;
    tokyonight)
      colorscheme_name="tokyonight-${variant}"
      [[ "$variant" == "day" ]] && background="light"
      ;;
    gruvbox)
      colorscheme_name="gruvbox"
      background="${variant}"
      ;;
    *)
      error "Unknown theme: ${theme}"
      return 1
      ;;
  esac

  # Create/update the colorscheme plugin file
  cat > "$nvim_theme_file" <<EOF
-- Auto-generated by theme-switch script
-- Theme: ${theme} ${variant}

return {
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = "${colorscheme_name}",
    },
  },
EOF

  # Add theme-specific plugin if needed
  case "$theme" in
    catppuccin)
      cat >> "$nvim_theme_file" <<EOF
  {
    "catppuccin/nvim",
    name = "catppuccin",
    opts = {
      flavour = "${variant}",
      background = {
        light = "latte",
        dark = "${variant}",
      },
    },
  },
EOF
      ;;
    tokyonight)
      cat >> "$nvim_theme_file" <<EOF
  {
    "folke/tokyonight.nvim",
    opts = {
      style = "${variant}",
    },
  },
EOF
      ;;
    gruvbox)
      cat >> "$nvim_theme_file" <<EOF
  {
    "ellisonleao/gruvbox.nvim",
    opts = {
      contrast = "hard",
    },
  },
EOF
      ;;
  esac

  # Close the plugin spec
  echo "}" >> "$nvim_theme_file"

  success "Nvim colorscheme config updated (restart nvim to apply)"
}

# Update bat configuration
update_bat() {
  local theme="$1"
  local variant="$2"
  local bat_conf="${DOTFILES_DIR}/bat/.config/bat/config"

  info "Updating bat theme to ${theme} ${variant}..."

  local bat_theme=""
  case "$theme:$variant" in
    catppuccin:latte) bat_theme="Catppuccin Latte" ;;
    catppuccin:frappe) bat_theme="Catppuccin Frappe" ;;
    catppuccin:macchiato) bat_theme="Catppuccin Macchiato" ;;
    catppuccin:mocha) bat_theme="Catppuccin Mocha" ;;
    gruvbox:light) bat_theme="gruvbox-light" ;;
    gruvbox:dark) bat_theme="gruvbox-dark" ;;
    tokyonight:*) bat_theme="TwoDark" ;;  # Fallback, bat doesn't have tokyonight
    *)
      warn "No bat theme mapping for ${theme}:${variant}, using default"
      return 0
      ;;
  esac

  if grep -q "^--theme=" "$bat_conf" 2>/dev/null; then
    sed -i.bak "s/^--theme=.*$/--theme=\"${bat_theme}\"/" "$bat_conf"
    rm -f "${bat_conf}.bak"
  else
    echo "--theme=\"${bat_theme}\"" >> "$bat_conf"
  fi

  success "Bat theme updated"
}

# Update yazi configuration
update_yazi() {
  local theme="$1"
  local variant="$2"

  info "Updating yazi theme to ${theme} ${variant}..."

  # Yazi uses Catppuccin flavors via its flavor system
  # We'll update the theme.toml to use the correct flavor

  case "$theme" in
    catppuccin)
      # Yazi theme config would go here
      success "Yazi theme updated (using ${variant})"
      ;;
    *)
      warn "Yazi theme switching for ${theme} not yet implemented"
      ;;
  esac
}

# Update FZF colors
update_fzf() {
  local theme="$1"
  local variant="$2"

  info "Updating FZF theme to ${theme} ${variant}..."

  # FZF colors are typically set via env vars in shell config
  # We'll create/update a theme-specific config file

  local fzf_theme_file="${DOTFILES_DIR}/fzf/fzf-theme.sh"

  case "$theme:$variant" in
    catppuccin:latte)
      cat > "$fzf_theme_file" <<'EOF'
# Catppuccin Latte theme for FZF
export FZF_DEFAULT_OPTS=" \
--color=bg+:#ccd0da,bg:#eff1f5,spinner:#dc8a78,hl:#d20f39 \
--color=fg:#4c4f69,header:#d20f39,info:#8839ef,pointer:#dc8a78 \
--color=marker:#dc8a78,fg+:#4c4f69,prompt:#8839ef,hl+:#d20f39"
EOF
      ;;
    catppuccin:mocha)
      cat > "$fzf_theme_file" <<'EOF'
# Catppuccin Mocha theme for FZF
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
EOF
      ;;
    *)
      warn "FZF theme for ${theme}:${variant} not defined yet"
      return 0
      ;;
  esac

  success "FZF theme updated (source shell config to apply)"
}

# Main theme switching function
switch_theme() {
  local theme="$1"
  local variant="$2"

  # Validate theme
  local found=false
  for theme_spec in "${THEMES[@]}"; do
    IFS=':' read -r t v _ _ <<< "$theme_spec"
    if [[ "$t" == "$theme" && "$v" == "$variant" ]]; then
      found=true
      break
    fi
  done

  if [[ "$found" != "true" ]]; then
    error "Unknown theme: ${theme} ${variant}"
    echo ""
    list_themes
    return 1
  fi

  echo ""
  info "Switching to theme: ${theme} ${variant}"
  echo ""

  # Update all tool configs
  local failed=false
  update_tmux "$theme" "$variant" || failed=true
  update_nvim "$theme" "$variant" || failed=true
  update_bat "$theme" "$variant" || failed=true
  update_fzf "$theme" "$variant" || failed=true
  update_yazi "$theme" "$variant" || failed=true

  if [[ "$failed" == "true" ]]; then
    error "Some theme updates failed"
    return 1
  fi

  # Save current theme
  save_current_theme "$theme" "$variant"

  echo ""
  success "Theme switched to: ${theme} ${variant}"
  echo ""
  info "To apply changes:"
  echo "  - Tmux: Already reloaded (if running)"
  echo "  - Nvim: Restart neovim or run :Lazy sync"
  echo "  - Shell tools: Source ~/.bashrc or restart shell"
  echo "  - iTerm2: Manual profile switch (if desired)"
  echo ""
}

# Main command dispatcher
main() {
  case "${1:-}" in
    list)
      list_themes
      ;;
    current)
      show_current
      ;;
    "")
      error "Missing theme argument"
      echo ""
      echo "Usage: theme-switch [THEME] [VARIANT]"
      echo "       theme-switch list"
      echo "       theme-switch current"
      echo ""
      list_themes
      exit 1
      ;;
    *)
      if [[ $# -lt 2 ]]; then
        error "Missing variant argument"
        echo ""
        echo "Usage: theme-switch [THEME] [VARIANT]"
        echo ""
        list_themes
        exit 1
      fi
      switch_theme "$1" "$2"
      ;;
  esac
}

# Run main function
main "$@"

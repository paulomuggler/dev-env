# DevEnv Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is gitignored and will not be committed

# LLM CLI API Keys (for future Phase 2)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_gemini_key_here

# Optional: Customize installation behavior
# DRY_RUN=false  # Set to true to preview changes without making them
# DEBUG=1        # Enable debug logging in scripts
# bat configuration file
# https://github.com/sharkdp/bat

# Set theme (Catppuccin Mocha when available, fallback to Monokai Extended)
--theme="Catppuccin Mocha"
# --theme="gruvbox-light"

# Show line numbers, Git modifications, and file header by default
--style="numbers,changes,header"

# Use italic text on the terminal (requires terminal support)
--italic-text=always

# Add mouse scrolling support
--paging=auto

# Map file extensions to languages for better syntax highlighting
--map-syntax "*.conf:INI"
--map-syntax ".ignore:Git Ignore"
--map-syntax "*.ino:C++"
--map-syntax ".env*:Bash"

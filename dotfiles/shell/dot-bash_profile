# -----------------------------------------------------------------------------
# .BASH_PROFILE
#
# Executed by login shells. This file sets up the environment and then
# sources .bashrc to configure the shell itself.
# -----------------------------------------------------------------------------

# Silence the "default interactive shell is now zsh" warning on macOS.
if [[ "$(uname -s)" == "Darwin" ]]; then
  export BASH_SILENCE_DEPRECATION_WARNING=1
fi

# -----------------------------------------------------------------------------
# ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# Set the default locale.
export LANG=en_US.UTF-8

# Set the terminal type. Important for colors and compatibility.
export TERM=xterm-256color

# -----------------------------------------------------------------------------
# PATH CONFIGURATION
#
# Source .bash_path which contains all PATH modifications from installed tools
# -----------------------------------------------------------------------------

if [[ -f ~/.bash_path ]]; then
  source ~/.bash_path
fi

# -----------------------------------------------------------------------------
# SOURCE .BASHRC
#
# Finally, load the interactive shell configuration.
# -----------------------------------------------------------------------------
if [[ -f ~/.bashrc ]]; then
  source ~/.bashrc
fi

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/paulomoreira/Downloads/google-cloud-sdk/path.bash.inc' ]; then . '/Users/paulomoreira/Downloads/google-cloud-sdk/path.bash.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/paulomoreira/Downloads/google-cloud-sdk/completion.bash.inc' ]; then . '/Users/paulomoreira/Downloads/google-cloud-sdk/completion.bash.inc'; fi

alias git-push-into-cl='git push origin HEAD:refs/for/main'

source /etc/bash_completion.d/hgd

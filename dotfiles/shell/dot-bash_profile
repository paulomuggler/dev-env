# -----------------------------------------------------------------------------
# .BASH_PROFILE
#
# Executed by login shells. This file sets up the environment and then
# sources .bashrc to configure the shell itself.
# -----------------------------------------------------------------------------

# Silence the "default interactive shell is now zsh" warning on macOS.
if [[ "$(uname -s)" == "Darwin" ]]; then
  export BASH_SILENCE_DEPRECATION_WARNING=1
fi

# -----------------------------------------------------------------------------
# ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# Set the default locale.
export LANG=en_US.UTF-8

# Set the terminal type. Important for colors and compatibility.
export TERM=xterm-256color

# -----------------------------------------------------------------------------
# PATH CONFIGURATION
#
# Source .bash_path which contains all PATH modifications from installed tools
# -----------------------------------------------------------------------------

if [[ -f ~/.bash_path ]]; then
  source ~/.bash_path
fi

# -----------------------------------------------------------------------------
# SOURCE .BASHRC
#
# Finally, load the interactive shell configuration.
# -----------------------------------------------------------------------------
if [[ -f ~/.bashrc ]]; then
  source ~/.bashrc
fi

# dev-env: Hyprland auto-start
# Automatically start Hyprland when logging in on TTY1
# This enables headless remote desktop operation
if [[ -z "${WAYLAND_DISPLAY:-}" ]] && [[ "$(tty)" == "/dev/tty1" ]]; then
  # Use uwsm if available (Omarchy default), otherwise direct Hyprland
  if command -v uwsm &>/dev/null; then
    exec uwsm start hyprland-uwsm.desktop
  else
    exec Hyprland
  fi
fi

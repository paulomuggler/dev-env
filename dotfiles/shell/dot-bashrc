# -----------------------------------------------------------------------------
# .BASHRC
#
# Executed by interactive shells. This file configures the shell prompt,
# tools, and sources aliases and functions.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# PATH & ENVIRONMENT
#
# On Linux, terminal emulators often spawn non-login shells that skip
# .bash_profile. Source PATH and env here (guarded) so every interactive
# shell gets them.
# -----------------------------------------------------------------------------

if [[ -z "${BASH_PROFILE_SOURCED:-}" ]]; then
  export LANG="${LANG:-en_US.UTF-8}"

  if [[ -f ~/.bash_path ]]; then
    source ~/.bash_path
  fi

  if [[ -f "$HOME/.cargo/env" ]]; then
    . "$HOME/.cargo/env"
  fi
fi

# Load custom environment variables (if not using .env file)
if [[ -f ~/.bash_env ]]; then
  source ~/.bash_env
fi

# Load custom aliases
if [[ -f ~/.bash_aliases ]]; then
  source ~/.bash_aliases
fi

# Load custom functions
if [[ -f ~/.bash_functions ]]; then
  source ~/.bash_functions
fi

# -----------------------------------------------------------------------------
# TOOL-SPECIFIC CONFIGURATIONS
# Source all tool configs from ~/.shell.d/ directory
# Each tool gets its own file for modular configuration
#
# SOURCING ORDER NOTE:
# .shell.d/ configs are sourced AFTER .bash_aliases and .bash_functions.
# This means tool-specific aliases/functions will override any defaults set above.
# This is intentional - allows fallback defaults while giving tools precedence.
# -----------------------------------------------------------------------------

if [[ -d ~/.shell.d ]]; then
  for config in ~/.shell.d/*.sh; do
    if [[ -f "${config}" ]]; then
      source "${config}"
    fi
  done
fi

# Link the 'set_win_title' function to Starship's pre-command hook
# to automatically update the terminal window title.
starship_precmd_user_func="set_win_title"

# -----------------------------------------------------------------------------
# MISC & USER-SPECIFIC
# -----------------------------------------------------------------------------

# Source iTerm2 shell integration if it exists (macOS only).
if [[ "$(uname -s)" == "Darwin" ]] && [[ -f "${HOME}/.iterm2_shell_integration.bash" ]]; then
  source "${HOME}/.iterm2_shell_integration.bash"
fi

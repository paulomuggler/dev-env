{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/todo-resume.sh",
            "statusMessage": "Checking for in-progress TODO work..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/todo-work-loop-stop.sh",
            "statusMessage": "Checking work loop status..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-plan.sh",
            "statusMessage": "Validating plan against current task..."
          }
        ]
      }
    ]
  }
}
